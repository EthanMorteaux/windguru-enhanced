{
  "manifest_version": 3,

  "name": "Windguru Enhanced",

  "version": "1.0.0",

  "description": "An enhanced version of Windguru.",

  "content_scripts": [
    {
      "matches": [
        "https://www.windguru.cz/*"
      ],
      "js": [
        "dist/script.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
